RIFT_ENVIRONMENT=pilot
RIFT_LOG_LEVEL=INFO
RIFT_PUBLIC_HOST=rift.staging.example.test
RIFT_FRONTEND_ORIGIN=https://rift.staging.example.test
RIFT_DATABASE_URL=postgresql+asyncpg://rift:REPLACE_DATABASE_PASSWORD@managed-postgres.example.test:5432/rift?ssl=verify-full
RIFT_DATABASE_CIDRS=REPLACE_WITH_MANAGED_DATABASE_IPV4_CIDR
RIFT_MASTER_KEY_B64=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL
RIFT_BACKUP_KEY_B64=REPLACE_WITH_A_DIFFERENT_32_BYTE_BASE64URL_KEY
RIFT_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RIFT_OPERATOR_USERNAME=operator
RIFT_OPERATOR_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
RIFT_ALLOWED_TARGET_CIDRS=REPLACE_WITH_AUTHORIZED_TARGET_IPV4_CIDR
RIFT_TLS_CERT_FILE=./secrets/rift.crt
RIFT_TLS_KEY_FILE=./secrets/rift.key
RIFT_RAW_EVIDENCE_RETENTION_DAYS=30
RIFT_CREDENTIAL_RETENTION_DAYS=30
RIFT_REPORT_RETENTION_DAYS=180
RIFT_DATABASE_CAPACITY_WARNING_BYTES=5368709120
RIFT_DISK_FREE_WARNING_BYTES=1073741824
POSTGRES_DB=rift
POSTGRES_USER=rift
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
