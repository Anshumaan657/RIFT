RIFT_ENVIRONMENT=development
RIFT_LOG_LEVEL=INFO
RIFT_DATABASE_URL=postgresql+asyncpg://rift:change-me@postgres:5432/rift
RIFT_MASTER_KEY_B64=REPLACE_WITH_32_RANDOM_BYTES_ENCODED_AS_BASE64URL
RIFT_FRONTEND_ORIGIN=http://localhost:15173
RIFT_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RIFT_OPERATOR_USERNAME=operator
RIFT_OPERATOR_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
RIFT_SESSION_TTL_SECONDS=3600
RIFT_LOGIN_ATTEMPTS=5
RIFT_LOGIN_WINDOW_SECONDS=900
RIFT_LOCAL_LAB_MODE=false
RIFT_ALLOWED_TARGET_CIDRS=
RIFT_RAW_EVIDENCE_RETENTION_DAYS=30
RIFT_CREDENTIAL_RETENTION_DAYS=30
RIFT_REPORT_RETENTION_DAYS=180
RIFT_DATABASE_CAPACITY_WARNING_BYTES=5368709120
RIFT_DISK_FREE_WARNING_BYTES=1073741824
RIFT_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
RIFT_MAX_REQUESTS_PER_ASSESSMENT=100
RIFT_MAX_CONCURRENT_REQUESTS=2
RIFT_MAX_REQUESTS_PER_SECOND_PER_HOST=2.0
RIFT_CONNECT_TIMEOUT_SECONDS=10
RIFT_REQUEST_TIMEOUT_SECONDS=20
RIFT_MAX_RESPONSE_BODY_BYTES=1048576
RIFT_MAX_ASSESSMENT_RUNTIME_SECONDS=900
RIFT_API_PORT=18000
RIFT_FRONTEND_PORT=15173
POSTGRES_DB=rift
POSTGRES_USER=rift
POSTGRES_PASSWORD=change-me
